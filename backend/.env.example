# Optional server-side generation. Leave blank for local source-backed replay.
SARVAM_API_KEY=

# Local storage and model cache. Defaults use the platform application-data folder.
# APP_DATA_DIR=C:\path\to\kivi-memory-data
# EMBEDDING_CACHE_DIR=C:\path\to\embedding-cache

CHAT_BASE_URL=https://api.sarvam.ai/v1
CHAT_MODEL=sarvam-105b
# Pricing defaults are a dated estimate for evaluation reports; override if rates change.
PROVIDER_INPUT_INR_PER_MILLION=29.28
PROVIDER_OUTPUT_INR_PER_MILLION=73.2
PROVIDER_PRICING_AS_OF=2026-09-09
# Omit MODEL_REASONING_EFFORT to send JSON null and reserve tokens for the answer.
MODEL_CONNECT_TIMEOUT_SECONDS=10
MODEL_READ_TIMEOUT_SECONDS=60
QUERY_DEADLINE_SECONDS=90
MODEL_MAX_ATTEMPTS=2
MAX_IMPORT_BYTES=10485760
MAX_RECORD_BYTES=262144
MAX_EVIDENCE_CHARS_PER_SOURCE=4000
MAX_EVIDENCE_CHARS_TOTAL=24000
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_MIN_SIMILARITY=0.72
TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173
